{
  "name": "budget-app",
  "private": true,
  "description": "Batzen (working title): Swiss budgeting app that makes spending feel like paying cash.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test:db --workspace @budget/db",
    "test:e2e": "npm run test:e2e --workspace @budget/mobile"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
