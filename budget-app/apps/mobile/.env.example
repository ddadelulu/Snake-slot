# Copy to .env.local (never commit real values). Only public values belong here: the Supabase
# project URL and its publishable (or legacy anon) key. Row-level security protects the data.
#
# Local development with `supabase start` (see docs/SETUP.md):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_KEY=<"Publishable key" or "anon key" printed by `supabase status`>
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
